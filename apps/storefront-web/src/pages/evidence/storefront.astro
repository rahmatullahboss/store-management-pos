---
import ProductCard from "../../components/ProductCard.astro";
import { parseStorefrontProductCardV1 } from "../../../../../packages/storefront-contracts/src/index.js";
import { buildStorefrontThemeTokensV1 } from "../../../../../packages/storefront-theme/src/index.js";

if (import.meta.env.STOREFRONT_EVIDENCE_MODE !== "1") {
  return new Response(null, {
    status: 404,
    headers: { "Cache-Control": "no-store" },
  });
}

const supportedLocales = ["en-GB", "bn-BD", "ar", "ja-JP"] as const;
type EvidenceLocale = (typeof supportedLocales)[number];
const requestedLocale = Astro.url.searchParams.get("locale");
const locale: EvidenceLocale = supportedLocales.includes(
  requestedLocale as EvidenceLocale,
)
  ? (requestedLocale as EvidenceLocale)
  : "en-GB";
const direction = locale === "ar" ? "rtl" : "ltr";
const copy = {
  "en-GB": {
    title: "Published storefront products",
    description: "Synthetic fixtures used only for responsive and accessibility evidence.",
    skip: "Skip to content",
    home: "Home",
    browse: "Browse",
    cart: "Cart",
    section: "This week’s selection",
    navLabel: "Primary navigation",
    evidence: "Storefront evidence",
    publishedCount: "published products",
    footer: "Synthetic evidence only. No customer or production data.",
  },
  "bn-BD": {
    title: "প্রকাশিত স্টোরফ্রন্ট পণ্য",
    description: "শুধু রেসপনসিভ লেআউট ও অ্যাক্সেসিবিলিটি যাচাইয়ের জন্য কৃত্রিম ডেটা।",
    skip: "মূল কনটেন্টে যান",
    home: "হোম",
    browse: "পণ্য দেখুন",
    cart: "কার্ট",
    section: "এই সপ্তাহের নির্বাচন",
    navLabel: "প্রধান নেভিগেশন",
    evidence: "স্টোরফ্রন্ট যাচাই",
    publishedCount: "টি প্রকাশিত পণ্য",
    footer: "শুধু কৃত্রিম যাচাই ডেটা। কোনো গ্রাহক বা প্রোডাকশন ডেটা নয়।",
  },
  ar: {
    title: "منتجات المتجر المنشورة",
    description: "بيانات تركيبية لاختبار العرض المتجاوب وإمكانية الوصول فقط.",
    skip: "انتقل إلى المحتوى",
    home: "الرئيسية",
    browse: "تصفح",
    cart: "السلة",
    section: "مختارات هذا الأسبوع",
    navLabel: "التنقل الرئيسي",
    evidence: "اختبار واجهة المتجر",
    publishedCount: "منتجات منشورة",
    footer: "بيانات اختبار تركيبية فقط. لا توجد بيانات عملاء أو إنتاج.",
  },
  "ja-JP": {
    title: "公開済みストアフロント商品",
    description: "レスポンシブ表示とアクセシビリティ検証専用の合成データです。",
    skip: "メインコンテンツへ移動",
    home: "ホーム",
    browse: "商品を見る",
    cart: "カート",
    section: "今週のセレクション",
    navLabel: "メインナビゲーション",
    evidence: "ストアフロント検証",
    publishedCount: "件の公開商品",
    footer: "合成された検証データのみです。顧客データや本番データは含みません。",
  },
}[locale];

const localised = <T,>(values: Record<EvidenceLocale, T>): T => values[locale];

const products = [
  parseStorefrontProductCardV1({
    contractVersion: "storefront-product-card.v1",
    productId: "product-linen-shirt",
    variantId: "variant-natural-medium",
    slug: "linen-shirt",
    name: localised({
      "en-GB": "Natural Linen Shirt",
      "bn-BD": "প্রাকৃতিক লিনেন শার্ট",
      ar: "قميص كتان طبيعي",
      "ja-JP": "ナチュラルリネンシャツ",
    }),
    publicationState: "published",
    availability: "available",
    pricePrefix: "none",
    price: { currency: "GBP", minor: "125050", scale: 2 },
    compareAtPrice: { currency: "GBP", minor: "150000", scale: 2 },
    media: {
      src: "/evidence/linen-shirt.svg",
      alt: localised({
        "en-GB": "Illustration of a linen shirt",
        "bn-BD": "লিনেন শার্টের চিত্র",
        ar: "رسم توضيحي لقميص كتان",
        "ja-JP": "リネンシャツのイラスト",
      }),
      width: 800,
      height: 1000,
    },
    badge: localised({
      "en-GB": "New",
      "bn-BD": "নতুন",
      ar: "جديد",
      "ja-JP": "新着",
    }),
  }),
  parseStorefrontProductCardV1({
    contractVersion: "storefront-product-card.v1",
    productId: "product-storage-basket",
    variantId: null,
    slug: "woven-storage-basket",
    name: localised({
      "en-GB": "Woven Storage Basket",
      "bn-BD": "বোনা স্টোরেজ ঝুড়ি",
      ar: "سلة تخزين منسوجة",
      "ja-JP": "編み込み収納バスケット",
    }),
    publicationState: "published",
    availability: "limited",
    pricePrefix: "from",
    price: { currency: "GBP", minor: "2899", scale: 2 },
    compareAtPrice: null,
    media: null,
    badge: null,
  }),
  parseStorefrontProductCardV1({
    contractVersion: "storefront-product-card.v1",
    productId: "product-desk-lamp",
    variantId: "variant-brass",
    slug: "adjustable-desk-lamp",
    name: localised({
      "en-GB": "Adjustable Desk Lamp",
      "bn-BD": "সমন্বয়যোগ্য ডেস্ক ল্যাম্প",
      ar: "مصباح مكتب قابل للتعديل",
      "ja-JP": "調整可能なデスクランプ",
    }),
    publicationState: "published",
    availability: "preorder",
    pricePrefix: "none",
    price: { currency: "GBP", minor: "8450", scale: 2 },
    compareAtPrice: null,
    media: null,
    badge: localised({
      "en-GB": "Coming soon",
      "bn-BD": "শীঘ্রই আসছে",
      ar: "قريباً",
      "ja-JP": "近日公開",
    }),
  }),
  parseStorefrontProductCardV1({
    contractVersion: "storefront-product-card.v1",
    productId: "product-tea-set",
    variantId: "variant-four-cup",
    slug: "stoneware-tea-set",
    name: localised({
      "en-GB": "Four-cup Stoneware Tea Set",
      "bn-BD": "চার-কাপ স্টোনওয়্যার টি সেট",
      ar: "طقم شاي خزفي بأربع أكواب",
      "ja-JP": "4客用ストーンウェアティーセット",
    }),
    publicationState: "published",
    availability: "unavailable",
    pricePrefix: "none",
    price: { currency: "GBP", minor: "6400", scale: 2 },
    compareAtPrice: { currency: "GBP", minor: "7200", scale: 2 },
    media: null,
    badge: null,
  }),
];

const theme = buildStorefrontThemeTokensV1({
  colors: {
    background: "#f7f5ee",
    foreground: "#17231e",
    surface: "#fffefa",
    surfaceMuted: "#edf2ee",
    primary: "#1f6a51",
    primaryForeground: "#ffffff",
    border: "#cbd5ce",
    danger: "#8f2929",
    focus: "#9a6200",
  },
  density: "comfortable",
  corner: "subtle",
  container: "wide",
});
const themeStyle = Object.entries(theme)
  .map(([key, value]) => `${key}:${value}`)
  .join(";");
---

<!doctype html>
<html lang={locale} dir={direction} style={themeStyle}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex,nofollow" />
    <title>{copy.title}</title>
  </head>
  <body>
    <a class="skip-link" href="#main-content">{copy.skip}</a>
    <header>
      <div class="container header-row">
        <a class="brand" href="/" aria-label={copy.home}>Synthetic Goods</a>
        <nav aria-label={copy.navLabel}>
          <a href="/">{copy.home}</a>
          <a href="/search">{copy.browse}</a>
          <a href="/cart">{copy.cart}</a>
        </nav>
      </div>
    </header>
    <main id="main-content" class="container" tabindex="-1">
      <section class="intro" aria-labelledby="evidence-title">
        <p class="eyebrow">{copy.evidence}</p>
        <h1 id="evidence-title">{copy.title}</h1>
        <p>{copy.description}</p>
      </section>
      <section aria-labelledby="product-grid-heading">
        <div class="section-heading">
          <h2 id="product-grid-heading">{copy.section}</h2>
          <p>{products.length} {copy.publishedCount}</p>
        </div>
        <div class="product-grid">
          {products.map((product, index) => (
            <ProductCard product={product} locale={locale} priority={index === 0} />
          ))}
        </div>
      </section>
    </main>
    <footer>
      <div class="container">{copy.footer}</div>
    </footer>
  </body>
</html>

<style>
  *,
  *::before,
  *::after {
    box-sizing: border-box;
  }

  html {
    font-family: ui-sans-serif, system-ui, -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif;
    background: var(--storefront-background);
    color: var(--storefront-foreground);
  }

  body {
    min-width: 20rem;
    min-height: 100vh;
    margin: 0;
    background: linear-gradient(180deg, var(--storefront-surface-muted), var(--storefront-background) 30rem);
    font-size: calc(1rem * var(--storefront-density));
    line-height: 1.5;
  }

  .container {
    width: min(calc(100% - 2rem), var(--storefront-container));
    margin-inline: auto;
  }

  .skip-link {
    position: fixed;
    inset-block-start: -6rem;
    inset-inline-start: 1rem;
    z-index: 20;
    padding: 0.75rem 1rem;
    border-radius: var(--storefront-radius);
    background: var(--storefront-foreground);
    color: var(--storefront-background);
    font-weight: 750;
  }

  .skip-link:focus {
    inset-block-start: 1rem;
    outline: 3px solid var(--storefront-focus);
    outline-offset: 3px;
  }

  header {
    border-bottom: 1px solid var(--storefront-border);
    background: color-mix(in srgb, var(--storefront-surface) 94%, transparent);
  }

  .header-row {
    display: flex;
    min-height: 4.5rem;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
  }

  .brand {
    color: inherit;
    font-weight: 800;
    letter-spacing: -0.025em;
    text-decoration: none;
  }

  nav {
    display: flex;
    align-items: center;
    gap: 0.4rem;
  }

  nav a {
    padding: 0.55rem 0.7rem;
    border-radius: var(--storefront-radius);
    color: inherit;
    text-decoration: none;
  }

  nav a:focus-visible,
  .brand:focus-visible {
    outline: 3px solid var(--storefront-focus);
    outline-offset: 3px;
  }

  main {
    padding-block: clamp(2.5rem, 7vw, 6rem);
  }

  main:focus {
    outline: none;
  }

  .intro {
    max-width: 50rem;
    margin-bottom: clamp(2.5rem, 7vw, 5rem);
  }

  .eyebrow {
    margin: 0 0 0.7rem;
    color: var(--storefront-primary);
    font-size: 0.78rem;
    font-weight: 800;
    letter-spacing: 0.12em;
    text-transform: uppercase;
  }

  h1 {
    margin: 0;
    font-size: clamp(2.35rem, 7vw, 5rem);
    line-height: 0.98;
    letter-spacing: -0.055em;
  }

  .intro > p:last-child {
    max-width: 42rem;
    margin: 1.2rem 0 0;
    color: color-mix(in srgb, var(--storefront-foreground) 72%, transparent);
    font-size: clamp(1rem, 2vw, 1.2rem);
  }

  .section-heading {
    display: flex;
    align-items: end;
    justify-content: space-between;
    gap: 1rem;
    margin-bottom: 1.2rem;
  }

  .section-heading h2,
  .section-heading p {
    margin: 0;
  }

  .section-heading h2 {
    font-size: clamp(1.45rem, 3vw, 2.1rem);
    letter-spacing: -0.03em;
  }

  .section-heading p {
    color: color-mix(in srgb, var(--storefront-foreground) 65%, transparent);
  }

  .product-grid {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: clamp(0.85rem, 2vw, 1.3rem);
  }

  footer {
    padding-block: 2rem;
    border-top: 1px solid var(--storefront-border);
    color: color-mix(in srgb, var(--storefront-foreground) 65%, transparent);
  }

  @media (max-width: 62rem) {
    .product-grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  @media (max-width: 38rem) {
    .header-row,
    .section-heading {
      align-items: flex-start;
      flex-direction: column;
    }

    .header-row {
      padding-block: 1rem;
    }

    nav {
      width: 100%;
      justify-content: space-between;
    }

    .product-grid {
      grid-template-columns: minmax(0, 1fr);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    *,
    *::before,
    *::after {
      scroll-behavior: auto !important;
      transition-duration: 0.01ms !important;
      animation-duration: 0.01ms !important;
      animation-iteration-count: 1 !important;
    }
  }
</style>
