---
import OrderTracking from "../../components/OrderTracking.astro";
import { deriveStorefrontOrderTrackingV1 } from "../../../../../packages/storefront-client/src/order-tracking.js";
import { buildStorefrontThemeTokensV1 } from "../../../../../packages/storefront-theme/src/index.js";

if (import.meta.env.STOREFRONT_EVIDENCE_MODE !== "1") {
  return new Response(null, {
    status: 404,
    headers: { "Cache-Control": "no-store" },
  });
}

const supportedLocales = ["en-GB", "bn-BD", "ar", "ja-JP"] as const;
type EvidenceLocale = (typeof supportedLocales)[number];
const requestedLocale = Astro.url.searchParams.get("locale");
const locale: EvidenceLocale = supportedLocales.includes(
  requestedLocale as EvidenceLocale,
)
  ? (requestedLocale as EvidenceLocale)
  : "en-GB";
const direction = locale === "ar" ? "rtl" : "ltr";

const copy = {
  "en-GB": {
    title: "Order tracking evidence",
    intro: "Synthetic buyer-safe order data used only to verify the read-only tracking experience.",
    skip: "Skip to order status",
    home: "Home",
    orders: "Orders",
    footer: "Synthetic order-status evidence only. No customer or production data.",
  },
  "bn-BD": {
    title: "অর্ডার ট্র্যাকিং যাচাই",
    intro: "শুধু read-only tracking experience যাচাইয়ের জন্য কৃত্রিম buyer-safe অর্ডার ডেটা।",
    skip: "অর্ডার স্ট্যাটাসে যান",
    home: "হোম",
    orders: "অর্ডার",
    footer: "শুধু কৃত্রিম অর্ডার স্ট্যাটাস যাচাই। কোনো গ্রাহক বা প্রোডাকশন ডেটা নয়।",
  },
  ar: {
    title: "اختبار تتبع الطلب",
    intro: "بيانات طلب تركيبية وآمنة للمشتري لاختبار تجربة التتبع للقراءة فقط.",
    skip: "انتقل إلى حالة الطلب",
    home: "الرئيسية",
    orders: "الطلبات",
    footer: "بيانات تركيبية لحالة الطلب فقط، ولا توجد بيانات عملاء أو إنتاج.",
  },
  "ja-JP": {
    title: "注文追跡の検証",
    intro: "読み取り専用の追跡体験を検証するための合成された購入者向け安全データです。",
    skip: "注文状況へ移動",
    home: "ホーム",
    orders: "注文",
    footer: "合成された注文状況検証データのみです。顧客データや本番データは含みません。",
  },
}[locale];

const syntheticDetail = {
  contractVersion: "storefront-order-detail.v1",
  context: {
    tenantId: "synthetic-tenant",
    storefrontId: "synthetic-storefront",
    salesChannelId: "synthetic-channel",
    requestHostname: "evidence.example.invalid",
    canonicalHostname: "evidence.example.invalid",
    locale,
    currency: "BHD",
    priceListRevision: "synthetic-price:17",
    publicationGeneration: "synthetic-publication:29",
  },
  orderId: "018f0000-0000-4000-8000-000000000701",
  documentNumber: "SO-SYNTHETIC-2026-000017",
  orderRevision: "9",
  createdAt: "2026-08-01T14:00:00.000Z",
  updatedAt: "2026-08-01T16:45:00.000Z",
  orderStatus: "on_hold",
  paymentStatus: "partially_paid",
  fulfillmentStatus: "partially_fulfilled",
  returnStatus: "partially_returned",
  total: { currency: "BHD", minor: "123456789", scale: 3 },
  fulfillmentMethod: "ship_from_store",
  lines: [
    {
      lineId: "018f0000-0000-4000-8000-000000000702",
      productId: "018f0000-0000-4000-8000-000000000703",
      variantId: "018f0000-0000-4000-8000-000000000704",
      sku: "SYNTHETIC-LONG-SKU-01",
      displayName: locale === "bn-BD"
        ? "দীর্ঘ নামের কৃত্রিম পণ্য যা ছোট স্ক্রিনে লেখা মোড়ানো যাচাই করে"
        : locale === "ar"
          ? "منتج تركيبي باسم طويل لاختبار التفاف النص على الشاشات الصغيرة"
          : locale === "ja-JP"
            ? "小さい画面で長い商品名の折り返しを確認するための合成商品"
            : "Synthetic product with a deliberately long name for narrow-screen wrapping evidence",
      quantity: { amount: "1250", unit: "metre", scale: 3 },
      unitPrice: { currency: "BHD", minor: "98765432", scale: 3 },
      discount: { currency: "BHD", minor: "1000", scale: 3 },
      tax: { currency: "BHD", minor: "1234", scale: 3 },
      total: { currency: "BHD", minor: "123456789", scale: 3 },
    },
  ],
} as const;

const tracking = deriveStorefrontOrderTrackingV1(syntheticDetail);
const theme = buildStorefrontThemeTokensV1({
  colors: {
    background: "#f7f5ee",
    foreground: "#17231e",
    surface: "#fffefa",
    surfaceMuted: "#edf2ee",
    primary: "#1f6a51",
    primaryForeground: "#ffffff",
    border: "#cbd5ce",
    danger: "#8f2929",
    focus: "#9a6200",
  },
  density: "comfortable",
  corner: "subtle",
  container: "wide",
});
const themeStyle = Object.entries(theme)
  .map(([key, value]) => `${key}:${value}`)
  .join(";");
---

<!doctype html>
<html lang={locale} dir={direction} style={themeStyle}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex,nofollow" />
    <title>{copy.title}</title>
  </head>
  <body>
    <a class="skip-link" href="#order-status">{copy.skip}</a>
    <header>
      <div class="container header-row">
        <a class="brand" href="/" aria-label={copy.home}>Synthetic Goods</a>
        <nav aria-label="Evidence navigation">
          <a href="/">{copy.home}</a>
          <a href="#order-status">{copy.orders}</a>
        </nav>
      </div>
    </header>
    <main id="order-status" class="container" tabindex="-1">
      <section class="intro" aria-labelledby="tracking-evidence-title">
        <p class="eyebrow">H5 tracking</p>
        <h1 id="tracking-evidence-title">{copy.title}</h1>
        <p>{copy.intro}</p>
      </section>
      <OrderTracking tracking={tracking} locale={locale} />
    </main>
    <footer><div class="container">{copy.footer}</div></footer>
  </body>
</html>

<style>
  *,
  *::before,
  *::after { box-sizing: border-box; }
  html {
    font-family: ui-sans-serif, system-ui, -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif;
    background: var(--storefront-background);
    color: var(--storefront-foreground);
  }
  body {
    min-width: 20rem;
    min-height: 100vh;
    margin: 0;
    background: linear-gradient(180deg, var(--storefront-surface-muted), var(--storefront-background) 28rem);
    font-size: calc(1rem * var(--storefront-density));
    line-height: 1.5;
  }
  .container {
    width: min(calc(100% - 2rem), var(--storefront-container));
    margin-inline: auto;
  }
  .skip-link {
    position: fixed;
    inset-block-start: -6rem;
    inset-inline-start: 1rem;
    z-index: 20;
    padding: .75rem 1rem;
    border-radius: var(--storefront-radius);
    background: var(--storefront-foreground);
    color: var(--storefront-background);
    font-weight: 750;
  }
  .skip-link:focus {
    inset-block-start: 1rem;
    outline: 3px solid var(--storefront-focus);
    outline-offset: 3px;
  }
  header {
    border-bottom: 1px solid var(--storefront-border);
    background: var(--storefront-surface);
  }
  .header-row {
    display: flex;
    min-height: 4.5rem;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
  }
  .brand { font-weight: 750; text-decoration: none; }
  nav { display: flex; gap: .5rem; flex-wrap: wrap; }
  nav a {
    padding: .55rem;
    border-radius: var(--storefront-radius);
    color: inherit;
  }
  nav a:focus-visible {
    outline: 3px solid var(--storefront-focus);
    outline-offset: 3px;
  }
  main { padding-block: clamp(2.5rem, 7vw, 5rem); }
  .intro { display: grid; gap: .8rem; max-width: 54rem; }
  .intro h1, .intro p { margin: 0; }
  .intro h1 { font-size: clamp(2rem, 7vw, 4.5rem); line-height: 1; letter-spacing: -.045em; }
  .intro p:last-child { color: color-mix(in srgb, var(--storefront-foreground) 72%, transparent); }
  .eyebrow { color: var(--storefront-primary); font-size: .78rem; font-weight: 750; letter-spacing: .1em; text-transform: uppercase; }
  footer {
    padding-block: 2rem;
    border-top: 1px solid var(--storefront-border);
    color: color-mix(in srgb, var(--storefront-foreground) 65%, transparent);
  }
  @media (max-width: 40rem) {
    .header-row { align-items: flex-start; flex-direction: column; padding-block: 1rem; }
  }
  @media (prefers-reduced-motion: reduce) {
    *, *::before, *::after {
      scroll-behavior: auto !important;
      transition-duration: .01ms !important;
      animation-duration: .01ms !important;
      animation-iteration-count: 1 !important;
    }
  }
</style>
