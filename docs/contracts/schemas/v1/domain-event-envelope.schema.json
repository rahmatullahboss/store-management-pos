{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://contracts.ozzyl.example/v1/domain-event-envelope.schema.json",
  "title": "DomainEventEnvelopeV1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "eventId", "eventType", "aggregateType", "aggregateId", "tenantId", "occurredAt", "businessDate", "correlationId", "payload", "metadata"],
  "properties": {
    "schemaVersion": {"const": "1.0"},
    "eventId": {"type": "string", "format": "uuid"},
    "eventType": {"type": "string", "minLength": 3},
    "aggregateType": {"type": "string", "minLength": 1},
    "aggregateId": {"type": "string", "minLength": 1},
    "tenantId": {"type": "string", "format": "uuid"},
    "occurredAt": {"type": "string", "format": "date-time"},
    "businessDate": {"type": "string", "format": "date"},
    "correlationId": {"type": "string", "minLength": 1},
    "causationId": {"type": "string"},
    "actorId": {"type": "string", "format": "uuid"},
    "payload": {},
    "metadata": {"type": "object", "additionalProperties": {"type": "string"}}
  }
}
